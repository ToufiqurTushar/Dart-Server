[Unit]
Description=Apex Blog Serverpod Backend Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/Dart-Server/my_app_server
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/dart/bin"
ExecStart=/usr/bin/env dart bin/main.dart --apply-migrations
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=apex_blog_server

[Install]
WantedBy=multi-user.target
